{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "https://walkthrulabs.com/portfolio/",
      "permanent": false
    },
    {
      "source": "/portfolio.html",
      "destination": "https://walkthrulabs.com/portfolio/",
      "permanent": false
    }
  ]
}